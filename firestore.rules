rules_version = '2';

// Role-based access for the clinic appointment system. Anything not matched
// below is denied. Each collection issue adds its own block and rules tests
// under firebase/rules_test/.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads the caller's own profile; only callable when signed in.
    function hasAdminProfile() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && hasAdminProfile();
    }

    function isFilledString(value) {
      return value is string && value.trim().size() > 0;
    }

    // The department must exist and belong to the branch.
    function isDepartmentOfBranch(data) {
      let department =
        /databases/$(database)/documents/departments/$(data.departmentId);
      return exists(department)
        && get(department).data.branchId == data.branchId;
    }

    // users/{uid}: profiles keyed by the authentication uid.
    match /users/{uid} {
      // Owners and admins read any profile; signed-in users read staff
      // profiles so patients can choose a doctor.
      allow read: if isUser(uid)
        || isAdmin()
        || (isSignedIn() && resource.data.role in ['doctor', 'technician']);

      // Registration creates an own patient profile or an admin-managed staff profile.
      allow create: if isOwnPatientProfile()
        || (isAdmin() && isValidStaffProfile(request.resource.data));

      // Owners change their name; admins manage staff assignments.
      allow update: if isOwnNameChange()
        || (isAdmin() && isStaffAssignmentChange());

      allow delete: if isAdmin();

      function staffKeys() {
        return [
          'role', 'fullName', 'email', 'branchId', 'departmentId',
          'serviceIds', 'createdAt'
        ];
      }

      function isValidStaffProfile(data) {
        let keys = data.role == 'doctor'
          ? staffKeys().concat(['specialty']) : staffKeys();
        return data.role in ['doctor', 'technician']
          && data.keys().hasOnly(keys)
          && data.keys().hasAll(keys)
          && isFilledString(data.fullName)
          && data.email is string
          && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && isFilledString(data.branchId)
          && isFilledString(data.departmentId)
          && isDepartmentOfBranch(data)
          && isValidStaffAssignment(data)
          && data.createdAt == request.time;
      }

      function isValidStaffAssignment(data) {
        return isFilledString(data.fullName)
          && data.serviceIds is list
          && data.serviceIds.size() <= 20
          && (data.role == 'doctor'
            ? isFilledString(data.specialty)
            : !('specialty' in data));
      }

      function isStaffAssignmentChange() {
        return resource.data.role in ['doctor', 'technician']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'specialty', 'serviceIds'])
          && isValidStaffAssignment(request.resource.data);
      }

      function isOwnPatientProfile() {
        let profile = request.resource.data;
        return isUser(uid)
          && profile.keys().hasOnly(['role', 'fullName', 'email', 'createdAt'])
          && profile.keys().hasAll(['role', 'fullName', 'email', 'createdAt'])
          && profile.role == 'patient'
          && isFilledString(profile.fullName)
          && profile.email == request.auth.token.email
          && profile.createdAt == request.time;
      }

      function isOwnNameChange() {
        return isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName'])
          && isFilledString(request.resource.data.fullName);
      }
    }

    // clinics/{clinicId}: named institutions that own physical branches.
    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidClinic(request.resource.data);
      allow delete: if false;

      function isValidClinic(data) {
        return data.keys().hasOnly(['name'])
          && data.keys().hasAll(['name'])
          && isFilledString(data.name);
      }
    }

    // branches/{branchId}: clinic locations with weekday working hours.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidBranch(request.resource.data);
      allow update: if isAdmin() && isValidBranchUpdate(request.resource.data);
      allow delete: if false;

      function isValidBranch(data) {
        return data.keys().hasOnly([
            'clinicId', 'name', 'address', 'workingHours'
          ])
          && data.keys().hasAll([
            'clinicId', 'name', 'address', 'workingHours'
          ])
          && data.clinicId is string
          && exists(/databases/$(database)/documents/clinics/$(data.clinicId))
          && isFilledString(data.name)
          && isFilledString(data.address)
          && isValidWorkingHours(data.workingHours);
      }

      function isValidWorkingHours(workingHours) {
        return workingHours is map
          && workingHours.keys().hasOnly([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && workingHours.keys().hasAll([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && workingHours.monday is list
          && workingHours.tuesday is list
          && workingHours.wednesday is list
          && workingHours.thursday is list
          && workingHours.friday is list
          && workingHours.saturday is list
          && workingHours.sunday is list;
      }

      function isValidBranchUpdate(data) {
        return isValidBranch(data)
          && data.clinicId == resource.data.clinicId;
      }
    }

    // departments/{departmentId}: medical units belonging to a branch.
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDepartment(request.resource.data);
      allow update: if isAdmin()
        && isValidDepartment(request.resource.data)
        && request.resource.data.branchId == resource.data.branchId;
      allow delete: if false;

      function isValidDepartment(data) {
        return data.keys().hasOnly(['branchId', 'name'])
          && data.keys().hasAll(['branchId', 'name'])
          && data.branchId is string
          && exists(/databases/$(database)/documents/branches/$(data.branchId))
          && isFilledString(data.name);
      }
    }

    // services/{serviceId}: examinations, radiology services and lab tests
    // offered by a branch department. Kind, branch and department are fixed
    // after creation; fees are stored in minor units (1 ₺ = 100).
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidService(request.resource.data);
      allow update: if isAdmin()
        && isValidService(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.departmentId == resource.data.departmentId;
      allow delete: if false;

      function commonKeys() {
        return [
          'kind', 'branchId', 'departmentId', 'name',
          'durationMinutes', 'feeMinorUnits'
        ];
      }

      function isValidService(data) {
        return data.keys().hasAll(commonKeys())
          && isValidCommonFields(data)
          && isDepartmentOfBranch(data)
          && (isValidExamination(data)
            || isValidRadiology(data)
            || isValidLabTest(data));
      }

      function isValidCommonFields(data) {
        return data.kind is string
          && data.branchId is string
          && data.departmentId is string
          && isFilledString(data.name)
          && data.durationMinutes is int
          && data.durationMinutes >= 5
          && data.durationMinutes <= 240
          && data.feeMinorUnits is int
          && data.feeMinorUnits >= 100
          && data.feeMinorUnits <= 10000000;
      }

      function isValidExamination(data) {
        return data.kind == 'examination'
          && data.keys().hasOnly(commonKeys());
      }

      function isValidRadiology(data) {
        return data.kind == 'radiology'
          && data.keys().hasOnly(commonKeys().concat([
            'modality', 'preparationNote'
          ]))
          && data.keys().hasAll(['modality'])
          && data.modality in ['xRay', 'ultrasound', 'mri', 'ct']
          && (!('preparationNote' in data)
            || isValidPreparationNote(data.preparationNote));
      }

      function isValidPreparationNote(note) {
        return isFilledString(note) && note.size() <= 200;
      }

      function isValidLabTest(data) {
        return data.kind == 'lab'
          && data.keys().hasOnly(commonKeys().concat([
            'requiresFasting', 'fastingHours', 'resultTime'
          ]))
          && data.keys().hasAll(['requiresFasting', 'resultTime'])
          && data.requiresFasting is bool
          && data.requiresFasting == ('fastingHours' in data)
          && (!('fastingHours' in data)
            || isValidFastingHours(data.fastingHours))
          && data.resultTime in [
            'sameDay', 'oneDay', 'twoDays', 'threeDays', 'oneWeek'
          ];
      }

      function isValidFastingHours(hours) {
        return hours is map
          && hours.keys().hasOnly(['min', 'max'])
          && hours.keys().hasAll(['min', 'max'])
          && hours.min is int
          && hours.max is int
          && hours.min >= 1
          && hours.min <= hours.max
          && hours.max <= 24;
      }
    }
  }
}
