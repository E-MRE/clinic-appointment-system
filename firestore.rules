rules_version = '2';

// Role-based access for the clinic appointment system. Anything not matched
// below is denied. Each collection issue adds its own block and rules tests
// under firebase/rules_test/.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads the caller's own profile; only callable when signed in.
    function hasAdminProfile() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && hasAdminProfile();
    }

    function isFilledString(value) {
      return value is string && value.trim().size() > 0;
    }

    // The department must exist and belong to the branch.
    function isDepartmentOfBranch(data) {
      let department =
        /databases/$(database)/documents/departments/$(data.departmentId);
      return exists(department)
        && get(department).data.branchId == data.branchId;
    }

    // users/{uid}: profiles keyed by the authentication uid.
    match /users/{uid} {
      // Owners and admins read any profile; signed-in users read staff
      // profiles so patients can choose a doctor.
      allow read: if isUser(uid)
        || isAdmin()
        || (isSignedIn() && resource.data.role in ['doctor', 'technician']);

      // Registration creates an own patient profile or an admin-managed staff profile.
      allow create: if isOwnPatientProfile()
        || (isAdmin() && isValidStaffProfile(request.resource.data));

      // Owners change their name; admins manage staff assignments.
      allow update: if isOwnNameChange()
        || (isAdmin() && isStaffAssignmentChange());

      allow delete: if isAdmin();

      function staffKeys() {
        return [
          'role', 'fullName', 'email', 'branchId', 'departmentId',
          'serviceIds', 'createdAt'
        ];
      }

      function isValidStaffProfile(data) {
        let keys = data.role == 'doctor'
          ? staffKeys().concat(['specialty']) : staffKeys();
        return data.role in ['doctor', 'technician']
          && data.keys().hasOnly(keys)
          && data.keys().hasAll(keys)
          && isFilledString(data.fullName)
          && data.email is string
          && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && isFilledString(data.branchId)
          && isFilledString(data.departmentId)
          && isDepartmentOfBranch(data)
          && isValidStaffAssignment(data)
          && data.createdAt == request.time;
      }

      function isValidStaffAssignment(data) {
        return isFilledString(data.fullName)
          && data.serviceIds is list
          && data.serviceIds.size() <= 20
          && (data.role == 'doctor'
            ? isFilledString(data.specialty)
            : !('specialty' in data));
      }

      function isStaffAssignmentChange() {
        return resource.data.role in ['doctor', 'technician']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'specialty', 'serviceIds'])
          && isValidStaffAssignment(request.resource.data);
      }

      function isOwnPatientProfile() {
        let profile = request.resource.data;
        return isUser(uid)
          && profile.keys().hasOnly(['role', 'fullName', 'email', 'createdAt'])
          && profile.keys().hasAll(['role', 'fullName', 'email', 'createdAt'])
          && profile.role == 'patient'
          && isFilledString(profile.fullName)
          && profile.email == request.auth.token.email
          && profile.createdAt == request.time;
      }

      function isOwnNameChange() {
        return isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName'])
          && isFilledString(request.resource.data.fullName);
      }
    }

    function occupiesSlot(status) {
      return status in ['pending', 'approved', 'completed', 'noShow'];
    }

    function releasesSlot(old, next) {
      return occupiesSlot(old.status)
        && next.status in ['rejected', 'cancelledByPatient', 'cancelledByStaff'];
    }

    function bookingSlot(appointmentId, data) {
      return { 'appointmentId': appointmentId, 'start': data.start, 'end': data.end };
    }

    function previousSlots(path) {
      return exists(path) ? get(path).data.slots : [];
    }

    function appendedDay(path, slot) {
      return getAfter(path).data.slots == previousSlots(path).concat([slot]);
    }

    function releasedDay(path, slot) {
      return getAfter(path).data.slots == previousSlots(path).removeAll([slot]);
    }

    function unchangedDay(path) {
      return exists(path)
        ? getAfter(path).data == get(path).data
        : !existsAfter(path);
    }

    // Overlap is enforced by the client transaction and domain validator;
    // rules only keep the busy-slot projection in sync with appointments.
    function validBookingProjection(appointmentId, data) {
      let staffDay = /databases/$(database)/documents/staffBookings/$(data.staffId)/days/$(data.date);
      let patientDay = /databases/$(database)/documents/patientBookings/$(data.patientId)/days/$(data.date);
      let slot = bookingSlot(appointmentId, data);
      return appendedDay(staffDay, slot) && appendedDay(patientDay, slot);
    }

    function validTransitionProjection(appointmentId, old, next) {
      let staffDay = /databases/$(database)/documents/staffBookings/$(old.staffId)/days/$(old.date);
      let patientDay = /databases/$(database)/documents/patientBookings/$(old.patientId)/days/$(old.date);
      let slot = bookingSlot(appointmentId, old);
      return releasesSlot(old, next)
        ? releasedDay(staffDay, slot) && releasedDay(patientDay, slot)
        : unchangedDay(staffDay) && unchangedDay(patientDay);
    }

    function validDayWrite(ownerId, date, ownerField) {
      let next = request.resource.data;
      let keys = ['slots', 'lastAppointmentId', 'updatedAt'];
      return next.keys().hasOnly(keys) && next.keys().hasAll(keys)
        && next.slots is list && isFilledString(next.lastAppointmentId)
        && next.updatedAt == request.time
        && pairedAppointment(ownerId, date, ownerField, next);
    }

    function pairedAppointment(ownerId, date, ownerField, next) {
      let path = /databases/$(database)/documents/appointments/$(next.lastAppointmentId);
      let existed = exists(path);
      let after = getAfter(path).data;
      let beforeSlots = resource == null ? [] : resource.data.slots;
      let slot = bookingSlot(next.lastAppointmentId, after);
      return after[ownerField] == ownerId && after.date == date
        && ((!existed && existsAfter(path)
            && next.slots == beforeSlots.concat([slot]))
          || (existed && releasesSlot(get(path).data, after)
            && next.slots == beforeSlots.removeAll([slot])));
    }

    match /staffBookings/{staffId}/days/{date} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && validDayWrite(staffId, date, 'staffId');
      allow delete: if false;
    }

    match /patientBookings/{patientId}/days/{date} {
      allow read: if isUser(patientId) || isAdmin();
      allow create, update: if isSignedIn() && validDayWrite(patientId, date, 'patientId');
      allow delete: if false;
    }

    // appointments/{appointmentId}: lifecycle changes append an audit entry.
    match /appointments/{appointmentId} {
      allow read: if resource != null && (isAdmin()
        || isUser(resource.data.patientId) || isUser(resource.data.staffId));
      allow create: if isSignedIn() && callerRole() == 'patient'
        && isValidAppointment(request.resource.data)
        && validBookingProjection(appointmentId, request.resource.data);
      allow update: if isSignedIn() && isValidUpdate()
        && validTransitionProjection(appointmentId, resource.data, request.resource.data);
      allow delete: if false;

      function callerRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }

      function isNearRequestTime(time) {
        return time is timestamp
          && time >= request.time - duration.value(5, 'm')
          && time <= request.time + duration.value(5, 'm');
      }

      function validEntry(entry, status, role) {
        return entry is map
          && entry.keys().hasOnly(['status', 'byUserId', 'byRole', 'at'])
          && entry.keys().hasAll(['status', 'byUserId', 'byRole', 'at'])
          && entry.status == status && entry.byUserId == request.auth.uid
          && entry.byRole == role && isNearRequestTime(entry.at);
      }

      function isValidAppointment(data) {
        let keys = ['patientId', 'staffId', 'branchId', 'departmentId',
          'serviceId', 'serviceName', 'feeMinorUnits', 'date', 'start', 'end',
          'status', 'history', 'createdAt', 'updatedAt'];
        return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
          && isUser(data.patientId) && isFilledString(data.staffId)
          && isFilledString(data.branchId) && isFilledString(data.departmentId)
          && isFilledString(data.serviceId) && isFilledString(data.serviceName)
          && data.feeMinorUnits is int && data.feeMinorUnits > 0
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.start is string && data.start.matches('^[0-9]{2}:[0-9]{2}$')
          && data.end is string && data.end.matches('^[0-9]{2}:[0-9]{2}$')
          && data.status == 'pending' && data.history is list
          && data.history.size() == 1 && validEntry(data.history[0], 'pending', 'patient')
          && data.createdAt == request.time && data.updatedAt == request.time
          && validStaff(data);
      }

      function validStaff(data) {
        let profile = /databases/$(database)/documents/users/$(data.staffId);
        return exists(profile) && staffMatchesAppointment(get(profile).data, data);
      }

      function staffMatchesAppointment(profile, data) {
        return profile.role in ['doctor', 'technician']
          && profile.branchId == data.branchId
          && profile.departmentId == data.departmentId;
      }

      // Time-based appointment limits are validated in the domain layer.
      function isValidUpdate() {
        let old = resource.data;
        let next = request.resource.data;
        let role = callerRole();
        return next.diff(old).affectedKeys().hasOnly(['status', 'history', 'updatedAt'])
          && next.updatedAt == request.time
          && old.history is list && old.history.size() > 0
          && next.history is list && next.history.size() == old.history.size() + 1
          && next.history[0:old.history.size()] == old.history
          && validEntry(next.history[old.history.size()], next.status, role)
          && next.history[old.history.size()].at >= old.history[old.history.size() - 1].at
          && allowedTransition(old, next.status, role);
      }

      function allowedTransition(old, status, role) {
        return (isUser(old.patientId) && role == 'patient'
            && old.status in ['pending', 'approved'] && status == 'cancelledByPatient')
          || (isUser(old.staffId) && role in ['doctor', 'technician']
            && ((old.status == 'pending' && status in ['approved', 'rejected'])
              || (old.status == 'approved' && status in ['cancelledByStaff', 'completed', 'noShow'])))
          || (role == 'admin'
            && ((old.status == 'pending' && status in ['approved', 'rejected'])
              || (old.status == 'approved' && status in ['cancelledByStaff', 'completed'])));
      }
    }

    // staffAvailability/{staffId}: one availability document per doctor or technician.
    match /staffAvailability/{staffId} {
      // Patients read availability to request appointments (#17).
      allow read: if isSignedIn();
      // Staff write their own document; admins write any staff member's.
      allow create, update: if (isUser(staffId) || isAdmin())
        && isValidAvailability(staffId, request.resource.data);
      allow delete: if false;

      function isValidAvailability(staffId, data) {
        let profile = /databases/$(database)/documents/users/$(staffId);
        return exists(profile)
          && get(profile).data.role in ['doctor', 'technician']
          && data.keys().hasOnly(['branchId', 'weekly', 'oneOff', 'updatedAt'])
          && data.keys().hasAll(['branchId', 'weekly', 'oneOff', 'updatedAt'])
          && data.branchId == get(profile).data.branchId
          && isValidWeekly(data.weekly)
          && data.oneOff is list && data.oneOff.size() <= 60
          && data.updatedAt == request.time;
      }

      // Rules cannot loop over elements; the domain validates their contents.
      // Limits 12 and 60 must match AvailabilityConstants.
      function isValidWeekly(weekly) {
        return weekly is map
          && weekly.keys().hasOnly([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && weekly.keys().hasAll([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && isValidDay(weekly.monday)
          && isValidDay(weekly.tuesday)
          && isValidDay(weekly.wednesday)
          && isValidDay(weekly.thursday)
          && isValidDay(weekly.friday)
          && isValidDay(weekly.saturday)
          && isValidDay(weekly.sunday);
      }

      function isValidDay(day) {
        return day is list && day.size() <= 12;
      }
    }

    // clinics/{clinicId}: named institutions that own physical branches.
    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidClinic(request.resource.data);
      allow delete: if false;

      function isValidClinic(data) {
        return data.keys().hasOnly(['name'])
          && data.keys().hasAll(['name'])
          && isFilledString(data.name);
      }
    }

    // branches/{branchId}: clinic locations with weekday working hours.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidBranch(request.resource.data);
      allow update: if isAdmin() && isValidBranchUpdate(request.resource.data);
      allow delete: if false;

      function isValidBranch(data) {
        return data.keys().hasOnly([
            'clinicId', 'name', 'address', 'workingHours'
          ])
          && data.keys().hasAll([
            'clinicId', 'name', 'address', 'workingHours'
          ])
          && data.clinicId is string
          && exists(/databases/$(database)/documents/clinics/$(data.clinicId))
          && isFilledString(data.name)
          && isFilledString(data.address)
          && isValidWorkingHours(data.workingHours);
      }

      function isValidWorkingHours(workingHours) {
        return workingHours is map
          && workingHours.keys().hasOnly([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && workingHours.keys().hasAll([
            'monday', 'tuesday', 'wednesday', 'thursday',
            'friday', 'saturday', 'sunday'
          ])
          && workingHours.monday is list
          && workingHours.tuesday is list
          && workingHours.wednesday is list
          && workingHours.thursday is list
          && workingHours.friday is list
          && workingHours.saturday is list
          && workingHours.sunday is list;
      }

      function isValidBranchUpdate(data) {
        return isValidBranch(data)
          && data.clinicId == resource.data.clinicId;
      }
    }

    // departments/{departmentId}: medical units belonging to a branch.
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDepartment(request.resource.data);
      allow update: if isAdmin()
        && isValidDepartment(request.resource.data)
        && request.resource.data.branchId == resource.data.branchId;
      allow delete: if false;

      function isValidDepartment(data) {
        return data.keys().hasOnly(['branchId', 'name'])
          && data.keys().hasAll(['branchId', 'name'])
          && data.branchId is string
          && exists(/databases/$(database)/documents/branches/$(data.branchId))
          && isFilledString(data.name);
      }
    }

    // services/{serviceId}: examinations, radiology services and lab tests
    // offered by a branch department. Kind, branch and department are fixed
    // after creation; fees are stored in minor units (1 ₺ = 100).
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidService(request.resource.data);
      allow update: if isAdmin()
        && isValidService(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.departmentId == resource.data.departmentId;
      allow delete: if false;

      function commonKeys() {
        return [
          'kind', 'branchId', 'departmentId', 'name',
          'durationMinutes', 'feeMinorUnits'
        ];
      }

      function isValidService(data) {
        return data.keys().hasAll(commonKeys())
          && isValidCommonFields(data)
          && isDepartmentOfBranch(data)
          && (isValidExamination(data)
            || isValidRadiology(data)
            || isValidLabTest(data));
      }

      function isValidCommonFields(data) {
        return data.kind is string
          && data.branchId is string
          && data.departmentId is string
          && isFilledString(data.name)
          && data.durationMinutes is int
          && data.durationMinutes >= 5
          && data.durationMinutes <= 240
          && data.feeMinorUnits is int
          && data.feeMinorUnits >= 100
          && data.feeMinorUnits <= 10000000;
      }

      function isValidExamination(data) {
        return data.kind == 'examination'
          && data.keys().hasOnly(commonKeys());
      }

      function isValidRadiology(data) {
        return data.kind == 'radiology'
          && data.keys().hasOnly(commonKeys().concat([
            'modality', 'preparationNote'
          ]))
          && data.keys().hasAll(['modality'])
          && data.modality in ['xRay', 'ultrasound', 'mri', 'ct']
          && (!('preparationNote' in data)
            || isValidPreparationNote(data.preparationNote));
      }

      function isValidPreparationNote(note) {
        return isFilledString(note) && note.size() <= 200;
      }

      function isValidLabTest(data) {
        return data.kind == 'lab'
          && data.keys().hasOnly(commonKeys().concat([
            'requiresFasting', 'fastingHours', 'resultTime'
          ]))
          && data.keys().hasAll(['requiresFasting', 'resultTime'])
          && data.requiresFasting is bool
          && data.requiresFasting == ('fastingHours' in data)
          && (!('fastingHours' in data)
            || isValidFastingHours(data.fastingHours))
          && data.resultTime in [
            'sameDay', 'oneDay', 'twoDays', 'threeDays', 'oneWeek'
          ];
      }

      function isValidFastingHours(hours) {
        return hours is map
          && hours.keys().hasOnly(['min', 'max'])
          && hours.keys().hasAll(['min', 'max'])
          && hours.min is int
          && hours.max is int
          && hours.min >= 1
          && hours.min <= hours.max
          && hours.max <= 24;
      }
    }
  }
}
